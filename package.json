{
  "name": "nimbus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nimbus V1: a cloud coding agent that works in an isolated sandbox and opens pull requests for human review.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.0"
  },
  "scripts": {
    "dev:services": "docker compose up -d --wait --wait-timeout 120",
    "dev:services:semantic": "docker compose --profile semantic up -d --wait --wait-timeout 180",
    "dev:services:status": "docker compose ps",
    "dev:services:logs": "docker compose logs -f --tail 100",
    "dev:services:down": "docker compose --profile semantic down",
    "dev:services:reset": "docker compose --profile semantic down --volumes",
    "dev": "pnpm -r --parallel dev",
    "demo:sandbox": "pnpm --filter @nimbus/api demo:sandbox",
    "demo:tools": "pnpm --filter @nimbus/api demo:tools",
    "demo:commands": "pnpm --filter @nimbus/api demo:commands",
    "demo:retrieval": "pnpm --filter @nimbus/api demo:retrieval",
    "demo:routing": "pnpm --filter @nimbus/api demo:routing",
    "demo:agent-state": "pnpm --filter @nimbus/api demo:agent-state",
    "demo:registry": "pnpm --filter @nimbus/api demo:registry",
    "demo:policy": "pnpm --filter @nimbus/api demo:policy",
    "demo:nodes": "pnpm --filter @nimbus/api demo:nodes",
    "demo:execute": "pnpm --filter @nimbus/api demo:execute",
    "demo:e2b": "pnpm --filter @nimbus/api demo:e2b",
    "demo:e2b:live": "pnpm --filter @nimbus/api demo:e2b:live",
    "demo:attachments:live": "pnpm --filter @nimbus/api demo:attachments:live",
    "demo:github:live": "pnpm --filter @nimbus/api demo:github:live",
    "demo:llm:live": "pnpm --filter @nimbus/api demo:llm:live",
    "build": "pnpm -r build",
    "typecheck": "tsc -b --pretty && pnpm -r --if-present run typecheck",
    "typecheck:clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "security:check": "pnpm audit --audit-level high",
    "clean": "pnpm -r exec rimraf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
