{
  "name": "@nimbus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nimbus trusted backend: authentication, GitHub gateway, agent orchestration, and the WebSocket event stream.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build:watch": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "demo:sandbox": "tsx test/manual/sandbox-demo.ts",
    "demo:tools": "tsx test/manual/tools-demo.ts",
    "demo:commands": "tsx test/manual/commands-demo.ts",
    "demo:retrieval": "tsx test/manual/retrieval-demo.ts",
    "demo:routing": "tsx test/manual/routing-demo.ts",
    "demo:agent-state": "tsx test/manual/agent-state-demo.ts",
    "demo:registry": "tsx test/manual/registry-demo.ts",
    "demo:policy": "tsx test/manual/policy-demo.ts",
    "demo:nodes": "tsx test/manual/nodes-demo.ts",
    "demo:execute": "tsx test/manual/execute-demo.ts",
    "demo:agent": "tsx test/manual/agent-demo.ts",
    "demo:agent:live": "tsx --env-file-if-exists=../../.env test/manual/agent-live.ts",
    "demo:e2b": "tsx test/manual/e2b-demo.ts",
    "demo:e2b:live": "tsx --env-file-if-exists=../../.env test/manual/e2b-live.ts",
    "demo:attachments:live": "tsx --env-file-if-exists=../../.env test/manual/attachments-live.ts",
    "demo:github:live": "tsx --env-file-if-exists=../../.env test/manual/github-write-live.ts",
    "demo:llm:live": "tsx --env-file-if-exists=../../.env test/manual/llm-live.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1110.0",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@nimbus/contracts": "workspace:*",
    "@octokit/rest": "22.0.1",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "e2b": "2.38.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "mongodb": "7.5.0",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "sharp": "0.35.3",
    "ws": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nimbus/test-utils": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
