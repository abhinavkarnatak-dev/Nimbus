{
  "name": "@nimbus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nimbus trusted backend: authentication, GitHub gateway, agent orchestration, and the WebSocket event stream.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nimbus/contracts": "workspace:*"
  },
  "devDependencies": {
    "@nimbus/test-utils": "workspace:*",
    "@types/node": "26.2.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
