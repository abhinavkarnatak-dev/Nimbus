    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
