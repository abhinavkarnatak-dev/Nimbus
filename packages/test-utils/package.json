{
  "name": "@nimbus/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared test helpers, fixtures, and fake adapters used by the Nimbus test suites.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nimbus/contracts": "workspace:*",
    "mongodb": "7.5.0"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
